{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "plugins": [{ "name": "next" }],
        "paths": {
            "@/*": ["./*"],
            "@domain/*": ["../../packages/domain/src/*"],
            "@ui/*": ["../../packages/ui/src/*"],
            "@database/*": ["../../packages/database/src/*"]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
