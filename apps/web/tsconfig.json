{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "plugins": [{ "name": "next" }],
        "paths": {
            "@/*": ["./*"]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        "vitest.config.mts",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
