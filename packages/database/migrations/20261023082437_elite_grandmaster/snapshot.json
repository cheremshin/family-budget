    {
      "value": "length(trim(\"name\")) > 0",
      "name": "budget_categories__name_format_check",
      "entityType": "checks",
      "schema": "public",
      "table": "budget_categories"
    },
    {
      "value": "(NOT \"is_system\") OR (NOT \"archived\")",
      "name": "budget_categories__system_not_archived_check",
      "entityType": "checks",
      "schema": "public",
      "table": "budget_categories"
    },
    {
      "value": "\n            (\"calculation_mode\" = 'relative' AND \"target_amount\" BETWEEN 0 AND 100)\n            OR\n            (\"calculation_mode\" = 'absolute' AND \"target_amount\" >= 0)\n        ",
      "name": "budget_categories__target_amount_consistency_check",
      "entityType": "checks",
      "schema": "public",
      "table": "budget_categories"
    },
    {
      "value": "\n                (\"archived\" = false AND \"archived_at\" IS NULL)\n                OR\n                (\"archived\" = true\n                    AND \"archived_at\" IS NOT NULL\n                    AND \"archived_at\" <= CURRENT_TIMESTAMP\n                )\n            ",
      "name": "budget_categories__archived_at_consistency_check",
      "entityType": "checks",
      "schema": "public",
      "table": "budget_categories"
    },
    {
      "value": "\"created_at\" <= CURRENT_TIMESTAMP",
      "name": "budget_categories__created_at_not_in_future_check",
      "entityType": "checks",
      "schema": "public",
      "table": "budget_categories"
    },
    {
      "value": "\"updated_at\" <= CURRENT_TIMESTAMP",
      "name": "budget_categories__updated_at_not_in_future_check",
      "entityType": "checks",
      "schema": "public",
      "table": "budget_categories"
    },
    {
      "value": "\"max_members\" >= 1",
      "name": "families__max_members_check",
      "entityType": "checks",
      "schema": "public",
      "table": "families"
    },
    {
      "value": "length(trim(\"name\")) > 0",
      "name": "families__name_format_check",
      "entityType": "checks",
      "schema": "public",
      "table": "families"
    },
    {
      "value": "\"invitation_code\" = upper(\"invitation_code\")",
      "name": "families__invitation_code_format_check",
      "entityType": "checks",
      "schema": "public",
      "table": "families"
    },
    {
      "value": "\"created_at\" <= CURRENT_TIMESTAMP",
      "name": "families__created_at_not_in_future_check",
      "entityType": "checks",
      "schema": "public",
      "table": "families"
    },
    {
      "value": "\"amount\" >= 0",
      "name": "incomes__amount_non_negative_check",
      "entityType": "checks",
      "schema": "public",
      "table": "incomes"
    },
    {
      "value": "\"received_at\" <= CURRENT_DATE",
      "name": "incomes__received_at_not_in_future_check",
      "entityType": "checks",
      "schema": "public",
      "table": "incomes"
    },
    {
      "value": "\"amount\" >= 0",
      "name": "monthly_budget_contributions__amount_non_negative_check",
      "entityType": "checks",
      "schema": "public",
      "table": "monthly_budget_contributions"
    },
    {
      "value": "\n            (\"calculation_mode\" = 'relative' AND \"target_amount\" BETWEEN 0 AND 100)\n            OR\n            (\"calculation_mode\" = 'absolute' AND \"target_amount\" >= 0)\n        ",
      "name": "monthly_budget_items__target_amount_consistency_check",
      "entityType": "checks",
      "schema": "public",
      "table": "monthly_budget_items"
    },
    {
      "value": "length(trim(\"category_name\")) > 0",
